[Desktop Entry]
Type=Application
Name=c³
GenericName=coraine Control Center
Comment=Compile, operate and explore coraine brokers
Exec=@EXEC@
Icon=com.seamware.c3
Terminal=false
StartupNotify=true
# The window c3 opens: c3-window, its Wayland app id (X11 class) com.seamware.c3. GNOME takes the window for
# c³'s: the icon shows it running, and a click shows it again - minimised or not - without starting c3 again.
StartupWMClass=com.seamware.c3
Categories=Development;
Keywords=coraine;NGSI-LD;broker;control;
